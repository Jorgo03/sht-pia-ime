{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "expo:lan"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "mobile-tunnel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "expo:tunnel"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "autoPort": false
    }
  ]
}