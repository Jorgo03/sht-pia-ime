# react-konva@^19.2.4 (used only by src/features/listings/components/floorplan/
# FloorPlanEditor.jsx, which nothing else in the app currently imports) requires
# react@^19.2.0, conflicting with this project's intentionally pinned react@19.1.0
# (must match react-native's bundled renderer exactly for the Expo app — see
# CLAUDE.md). Plain `npm install` fails on that peer conflict with ERESOLVE;
# every local install this project does already passes --legacy-peer-deps to
# accept it. This makes that the default so CI/Vercel builds (which otherwise
# run a bare `npm install`) don't fail on it too.
legacy-peer-deps=true
