# Copy to `.env` (Expo / React Native) and `.env.local` (Vite web app).
# Both real files are gitignored — never commit filled-in values.
#
# This repo holds TWO apps sharing one package.json:
#   - the Expo app  (npm run expo:start)  reads EXPO_PUBLIC_* from .env
#   - the Vite web app (npm run dev)      reads VITE_*        from .env.local
# The variables below are the same two Supabase values under each app's
# required prefix — the prefix is what makes the bundler expose them.
#
# Expo reads .env.local too, and it WINS over .env. `vercel env pull` rewrites
# .env.local with whatever Vercel holds, which has included a second,
# integration-created Supabase project. Both apps must point at the production
# project, xzzzhlwmzotibrxdqmcm; `npm start` prints which one the phone app is
# about to use and warns when it is not that one.

# --- .env  (Expo / React Native) ---------------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable "anon" key. Safe to ship in a client bundle — it is
# public by design and every table is gated by Row Level Security.
# Get it from: Dashboard > Project Settings > API Keys.
# NEVER put the service_role key here: it bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Legal document URLs. Optional: by default the app links to the website's own
# /privacy and /terms pages (EXPO_PUBLIC_SITE_URL below). Set these only if the
# documents move elsewhere. Public URLs, not secrets.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# The public website the phone app links to when sharing a listing
# (<site>/property/<id>). Defaults to the current Vercel deployment; set it
# once a custom domain is live. Must start with https://.
EXPO_PUBLIC_SITE_URL=

# --- .env.local  (Vite web app) ----------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The web app now hosts the pages itself at /privacy and /terms
# (src/features/legal) and links to them by route, so these two are optional.
# Point the Expo app's EXPO_PUBLIC_PRIVACY_POLICY_URL / EXPO_PUBLIC_TERMS_URL
# above at the deployed website, e.g. https://<your-domain>/privacy .
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=

# Contact address printed on /privacy and /terms. Leave empty until a real,
# monitored mailbox exists; the pages then point to the in-app Profile instead.
VITE_LEGAL_CONTACT_EMAIL=

# --- NOT set here: server-side secrets ---------------------------------
# These live in Supabase (Dashboard > Edge Functions > Secrets) and must
# never reach a client bundle or an EXPO_PUBLIC_/VITE_ variable:
#
#   ANTHROPIC_API_KEY   used by ai-generate-listing, ai-parse-search,
#                       ai-listing-assistant. Without it those functions
#                       return 503 `ai_unavailable` and the app falls back
#                       to manual entry rather than crashing.
#
# --- NOT set here: native build config ---------------------------------
#   Android Google Maps key -> GOOGLE_MAPS_ANDROID_API_KEY (below), which
#   app.config.js writes into android.config.googleMaps.apiKey at build time.
#   Only required for a standalone/EAS Android build. In Expo Go the map
#   renders using Expo Go's own key, so local testing needs nothing.
#   iOS uses Apple Maps and needs no key.

# --- Optional switches and build settings -----------------------------
# Every one has a safe default when unset; set them per environment
# (.env / .env.local locally, the hosting project's env vars, EAS secrets).

# Android Google Maps key for EAS/release builds (app.config.js). Empty: the
# Android map is blank in a release build. A build-time value, not a client
# secret, but restrict it to the app's package in Google Cloud.
GOOGLE_MAPS_ANDROID_API_KEY=
# 1 = free-Apple-ID iPhone build: strips push and Sign in with Apple
# (app.config.js, .github/workflows/ios-sideload.yml). Unset for store builds.
SIDELOAD_FREE=

# Buying plans on /pricing (website only). Off unless exactly "true", and only
# once the payment backend is live.
EXPO_PUBLIC_CHECKOUT_ENABLED=
VITE_CHECKOUT_ENABLED=
# Offer email alerts for saved searches. Off unless exactly "true"; turn on
# only once the alert emails are really being sent (RESEND_API_KEY etc.).
EXPO_PUBLIC_EMAIL_ALERTS=
VITE_EMAIL_ALERTS=
# Crash reports to the client_errors table. On in release builds unless set
# to "false"; always off in development.
EXPO_PUBLIC_ERROR_REPORTING=
VITE_ERROR_REPORTING=
# Version string attached to the website's crash reports. Optional.
VITE_APP_VERSION=
# Contact address on the phone app's privacy and terms pages (as
# VITE_LEGAL_CONTACT_EMAIL above). Empty until a monitored mailbox exists.
EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=
# 1 = request resized photos from Supabase image transforms (needs Supabase
# Pro). Off: photos load at their stored size.
EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=
# Website that relays Google sign-in back to the phone app (auth-context.tsx).
# Defaults to the current Vercel deployment; set it once the domain is live.
EXPO_PUBLIC_WEB_ORIGIN=
# Test builds only: width of the phone-sized column on the Expo website
# (default 480).
EXPO_PUBLIC_WEB_MAX_WIDTH=
